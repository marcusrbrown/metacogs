{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['github>marcusrbrown/renovate-config#5.2.16'],
  // Replaces Renovate's default node_modules/bower ignores, so they are restated; evals/ holds fixed fixtures.
  ignorePaths: ['**/node_modules/**', '**/bower_components/**', 'evals/**'],
  // The changeset commit-back is authored by the reusable workflow's bot identity; ignoring it keeps Renovate rebasing.
  gitIgnoredAuthors: ['118100583+bfra-me[bot]@users.noreply.github.com', '137683033+mrbro-bot[bot]@users.noreply.github.com'],
  customManagers: [
    {
      // The v2 CLI pin lives in package.json testedWith["opencode-v2"].
      description: ['Track the OpenCode v2 CLI pin (@opencode/cli) in package.json testedWith'],
      customType: 'regex',
      managerFilePatterns: ['/^package\\.json$/'],
      matchStrings: ['"opencode-v2"\\s*:\\s*"(?<currentValue>\\d+\\.\\d+\\.\\d+)"'],
      depNameTemplate: '@opencode/cli',
      datasourceTemplate: 'npm',
    },
  ],
  packageRules: [
    {
      // The CLI pin and the @opencode/plugin devDependency move together.
      matchPackageNames: ['@opencode/cli', '@opencode/plugin'],
      groupName: 'OpenCode v2',
      semanticCommitType: 'build',
    },
    {
      // RENOVATE_BINARY_SOURCE=install makes the built-in bun artifact step call install-tool, which fails there; postUpgradeTasks regenerates bun.lock.
      matchManagers: ['bun', 'npm'],
      skipArtifactsUpdate: true,
    },
  ],
  // `generate` rewrites the helpers that bake in the package version; both commands are on the reusable workflow's allowlist.
  postUpgradeTasks: {
    commands: ['bun install --ignore-scripts', 'bun run generate'],
    executionMode: 'branch',
  },
}
